<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net6.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="old\**" />
    <Compile Remove="ProgramFiles\jjj\**" />
    <Compile Remove="ProgramFiles\SysBlueprint\NodeManagement\NodeAggregate\**" />
    <EmbeddedResource Remove="old\**" />
    <EmbeddedResource Remove="ProgramFiles\jjj\**" />
    <EmbeddedResource Remove="ProgramFiles\SysBlueprint\NodeManagement\NodeAggregate\**" />
    <None Remove="old\**" />
    <None Remove="ProgramFiles\jjj\**" />
    <None Remove="ProgramFiles\SysBlueprint\NodeManagement\NodeAggregate\**" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
  </ItemGroup>

  <ItemGroup>
    <Compile Update="Properties\Resources.Designer.cs">
      <DesignTime>True</DesignTime>
      <AutoGen>True</AutoGen>
      <DependentUpon>Resources.resx</DependentUpon>
    </Compile>
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Update="Properties\Resources.resx">
      <Generator>ResXFileCodeGenerator</Generator>
      <LastGenOutput>Resources.Designer.cs</LastGenOutput>
    </EmbeddedResource>
  </ItemGroup>

  <ItemGroup>
    <Folder Include="ProgramData\" />
    <Folder Include="ProgramFiles\Packages\" />
    <Folder Include="ProgramFiles\SysBlueprint\AppManagement\AppService\" />
    <Folder Include="ProgramFiles\SysBlueprint\AppManagement\Vault\" />
    <Folder Include="ProgramFiles\SysBlueprint\AppManagement\User\" />
    <Folder Include="ProgramFiles\SysBlueprint\AppManagement\Language\" />
    <Folder Include="ProgramFiles\SysBlueprint\NodeManagement\Link\Application\" />
    <Folder Include="ProgramFiles\SysBlueprint\NodeManagement\Link\Infrastructure\" />
    <Folder Include="ProgramFiles\SysBlueprint\NodeManagement\Node\UserInterface\" />
    <Folder Include="ProgramFiles\SysBlueprint\NodeManagement\Note\Application\" />
    <Folder Include="ProgramFiles\SysBlueprint\NodeManagement\Note\Infrastructure\" />
    <Folder Include="ProgramFiles\SysBlueprint\UI\MainWindow\NavigationBar\" />
    <Folder Include="ProgramFiles\SysBlueprint\UI\MainWindow\AttributeBar\" />
    <Folder Include="ProgramFiles\SysBlueprint\UI\MainWindow\PageTab\" />
    <Folder Include="ProgramFiles\SysBlueprint\UI\MainWindow\ToolBar\" />
    <Folder Include="ProgramFiles\SysBlueprint\ViewManagement\" />
  </ItemGroup>

</Project>